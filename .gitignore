# Node
node_modules/

# Caches
.cache/
.tmp-*/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Hyperframes scratch renders (final.mp4 at each project root ships instead)
renders/

# Credentials / machine-local
.env
.env.*
!.env.example
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local-only media stash (large raw recordings, source music)
raw-media/

# Raw asset drop zone — stage media here; don't commit the big raw/prepped files
assets/incoming/*
!assets/incoming/README.md

# Prepped intermediate clips — regenerate with a project's
# scripts/pull-media.sh + scripts/prep-assets.sh (they carry the measured
# trim points, crop windows and grades). Only the final-*.mp4 deliverables
# at a project root are committed.
**/assets/broll/

# Playwright browser profiles
.playwright-profile/

# Frame-extraction scratch
**/renders/frames/
**/renders/frames-*/

# Render scratch dirs (any path)
**/render-work-*/
**/work-*/


# Generated alternate-ratio build dirs (make-ratios.py output)
**/build/
