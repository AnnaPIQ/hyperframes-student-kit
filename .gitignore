# Node
node_modules/

# Caches
.cache/
.tmp-*/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Hyperframes scratch renders (final.mp4 at each project root ships instead)
renders/

# Credentials / machine-local
.env
.env.*
!.env.example
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local-only media stash (large raw recordings, source music)
raw-media/

# Raw asset drop zone — stage media here; don't commit the big raw/prepped files
assets/incoming/*
!assets/incoming/README.md

# Raw master downloads (multi-GB Drive pulls; re-fetch with a project's pull-media.sh)
.dl/

# Generated ratio builds — make-ratios.py re-emits these from the master index.html
video-projects/*/build/

# Derived montage cuts — seconds of ffmpeg off the committed 9:16 master
# (scripts/prep-assets.sh regenerates them; the slow retime is skipped)
video-projects/*/assets/montage-4x5.mp4
video-projects/*/assets/montage-4x5-crop.mp4

# Playwright browser profiles
.playwright-profile/

# Frame-extraction scratch
**/renders/frames/
**/renders/frames-*/

# Render scratch dirs (any path)
**/render-work-*/
**/work-*/

