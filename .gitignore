# Node
node_modules/

# Caches
.cache/
.tmp-*/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Hyperframes scratch renders (final.mp4 at each project root ships instead)
renders/

# Credentials / machine-local
.env
.env.*
!.env.example
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local-only media stash (large raw recordings, source music)
raw-media/

# Raw asset drop zone — stage media here; don't commit the big raw/prepped files
assets/incoming/*
!assets/incoming/README.md

# Playwright browser profiles
.playwright-profile/

# Frame-extraction scratch
**/renders/frames/
**/renders/frames-*/

# Render scratch dirs (any path)
**/render-work-*/
**/work-*/


# Downloaded source footage scratch (fetched from Drive per-build; not a deliverable)
.media/

# Prepped A-roll crops are pure 4K-master crops (143 MB / 250 MB) — past
# GitHub's 100 MB per-file hard limit, and fully reproducible:
#   yt-dlp -f source -o .media/aroll-master.mov <drive A-roll url>
#   bash scripts/prep-aug-general-ad-5.sh .media/aroll-master.mov
video-projects/*/assets/aug5-aroll-*.mp4
